# ResuAI Server Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Gemini API Key (Required for AI operations)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Default: 8080)
PORT=8080

# Supabase Configuration (Required for database & auth integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# CORS Configuration (Optional: comma-separated origins, e.g. http://localhost:8080,https://yourdomain.com)
ALLOWED_ORIGINS=
